  "id": "dcs-grpc",
  "name": "DCS-gRPC",
  "summary": "gRPC server for DCS that lets external programs read mission data and send commands to a running mission.",
  "description": "A DCS gRPC server written in Rust: network clients can get data out of DCS and send commands into a running mission. Mainly used by server operators and tool developers.\n\nAfter installing, DCS-gRPC also needs a manual change to `Scripts\\MissionScripting.lua` in the DCS install folder; see its README.",
  "category": "utility",
  "tags": [
    "server",
    "api",
    "grpc",
    "scripting",
    "hooks"
  ],
  "authors": [
    {
      "name": "DCS-gRPC",
      "url": "https://github.com/DCS-gRPC"
    }
  ],
  "license": "AGPL-3.0",
  "homepage": "https://github.com/DCS-gRPC/rust-server",
  "source": "https://github.com/DCS-gRPC/rust-server",
